# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000
PORT=3001
SWAGGER_ENABLED=true

# Application database
DATABASE_URL=postgresql://cupomform:cupomform@postgres:5432/cupomform?schema=public

# API <> n8n (use a long random secret in production)
N8N_DELIVERY_WEBHOOK_URL=http://n8n:5678/webhook/cupom-delivery
N8N_SHARED_SECRET=change-me-to-a-long-random-secret
INTERNAL_CALLBACK_SECRET=change-me-to-a-different-long-random-secret

# n8n local service
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# n8n workflow: CupomForm delivery (configure in the n8n service, never commit real values)
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_INSTANCE=your-instance-name
EVOLUTION_API_KEY=change-me
CUPOMFORM_API_URL=http://localhost:3001
GOOGLE_SHEETS_DOCUMENT_ID=your-google-sheet-id
GOOGLE_SHEETS_SHEET_NAME=entregas
